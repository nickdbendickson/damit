{
 "schema": "damit.catalog.methods",
 "schema_version": 1,
 "source": "US Dam Hazard Classification - Corrected Edition (2026-11-09), Appendix A",
 "datums": {
  "ground": "depth_ground_ft",
  "foundation": "depth_foundation_ft",
  "floor": "depth_floor_ft"
 },
 "comparators": [
  ">",
  ">=",
  "<",
  "<=",
  "eq",
  "ne",
  "in"
 ],
 "verification_values": {
  "as_documented": "Stated in the corrected edition's Appendix A.",
  "unverified": "Marked (unverified) in the document; confirm before relying on it.",
  "secondary": "Marked (secondary) in the document; confirm before relying on it."
 },
 "methods": {
  "M1": {
   "name": "Depth-velocity lethality charts",
   "group": "structures_life_safety",
   "inputs": [
    "depth",
    "velocity",
    "m1_zone (chart zone at each habitable structure)",
    "model_dimension"
   ],
   "params": {
    "charts": [
     "houses_on_foundations",
     "mobile_homes",
     "passenger_vehicles",
     "adults",
     "children"
    ],
    "chart_source": "USBR ACER TM-11 Figures 2-6",
    "datum": "ground",
    "require_2d": false,
    "class_zones": [
     "high_danger"
    ],
    "judgment_zone_flag": true,
    "judgment_class": null,
    "curves_digitized_in_catalog": false
   },
   "returns": {
    "high_danger": 3,
    "judgment": "flag_for_engineer_review",
    "low_danger": "not_lethal_pass_to_M6"
   },
   "strength": "rule",
   "source": "USBR ACER TM-11 Figs 2-6; variants: REG_05 Figs 5.1-5.2; NY lowest occupied floor",
   "appendix_ref": "A.3 p.21-22",
   "verification": "as_documented",
   "applies_to": {
    "receptor_type": [
     "structure"
    ]
   },
   "special": "chart_zone",
   "evaluation": "auto",
   "notes": "Chart curves are not digitized in this catalog; the evaluator reads a per-structure m1_zone (high_danger / judgment / low_danger) supplied by DamIT Hazard or the engineer. Block when require_2d is true and the run is 1D."
  },
  "M2": {
   "name": "Flat depth threshold at habitable structures",
   "group": "structures_life_safety",
   "inputs": [
    "depth at habitable structures (datum)",
    "model_dimension"
   ],
   "params": {
    "depth_ft": 2.0,
    "comparator": ">",
    "datum": "ground",
    "only_if_1d": false,
    "structure_types": [
     "home",
     "mobile_home",
     "institution",
     "commercial_industrial",
     "campground"
    ]
   },
   "returns": 3,
   "strength": "rule",
   "source": "REG_05.2026 (ND, > 2 ft, 1D only); IDWR (Idaho, >= 2 ft at residences, sufficient not sole)",
   "appendix_ref": "A.3 p.22",
   "verification": "as_documented",
   "applies_to": {
    "receptor_type": [
     "structure"
    ]
   },
   "receptor_rules": [
    {
     "when": {
      "all": [
       [
        "wet",
        "eq",
        true
       ],
       [
        "habitable",
        "eq",
        true
       ],
       [
        "structure_type",
        "in",
        "$structure_types"
       ],
       [
        "@datum",
        "$comparator",
        "$depth_ft"
       ]
      ]
     },
     "class": 3
    }
   ],
   "evaluation": "auto"
  },
  "M3": {
   "name": "Structure-type depth and DV matrix",
   "group": "structures_life_safety",
   "inputs": [
    "structure_type",
    "depth_foundation_ft",
    "depth_floor_ft",
    "depth_ground_ft",
    "dv_ft2s",
    "walkout_basement"
   ],
   "params": {
    "home_high_depth_ft": 3.5,
    "home_high_dv": 20,
    "walkout_high_depth_ft": 3.5,
    "walkout_high_depth_ft_allowed": 5.0,
    "institution_high_depth_ft": 2.0,
    "institution_high_dv": 15,
    "commercial_sig_depth_ft": 1.0,
    "commercial_high_depth_ft": 3.5,
    "commercial_high_dv": 20,
    "campground_sig_depth_ft": 1.0,
    "campground_high_depth_ft": 3.5,
    "campground_high_dv": 8,
    "campground_min_nights_per_year": 25
   },
   "returns": {
    "Low": 1,
    "Significant": 2,
    "High": 3
   },
   "strength": "rule",
   "source": "Nebraska Classification of Dams (Dec. 2023) Table 3",
   "appendix_ref": "A.3 p.22-23",
   "verification": "as_documented",
   "applies_to": {
    "receptor_type": [
     "structure"
    ]
   },
   "receptor_rules": [
    {
     "label": "home High",
     "when": {
      "all": [
       [
        "wet",
        "eq",
        true
       ],
       [
        "structure_type",
        "eq",
        "home"
       ],
       [
        "walkout_basement",
        "ne",
        true
       ],
       {
        "any": [
         [
          "depth_foundation_ft",
          ">=",
          "$home_high_depth_ft"
         ],
         [
          "dv_ft2s",
          ">=",
          "$home_high_dv"
         ]
        ]
       }
      ]
     },
     "class": 3
    },
    {
     "label": "home (walkout basement) High",
     "when": {
      "all": [
       [
        "wet",
        "eq",
        true
       ],
       [
        "structure_type",
        "eq",
        "home"
       ],
       [
        "walkout_basement",
        "eq",
        true
       ],
       {
        "any": [
         [
          "depth_foundation_ft",
          ">=",
          "$walkout_high_depth_ft"
         ],
         [
          "dv_ft2s",
          ">=",
          "$home_high_dv"
         ]
        ]
       }
      ]
     },
     "class": 3
    },
    {
     "label": "home Significant",
     "when": {
      "all": [
       [
        "wet",
        "eq",
        true
       ],
       [
        "structure_type",
        "eq",
        "home"
       ],
       [
        "depth_foundation_ft",
        ">",
        0
       ]
      ]
     },
     "class": 2
    },
    {
     "label": "home Low",
     "when": {
      "all": [
       [
        "wet",
        "eq",
        true
       ],
       [
        "structure_type",
        "eq",
        "home"
       ]
      ]
     },
     "class": 1
    },
    {
     "label": "institution High",
     "when": {
      "all": [
       [
        "wet",
        "eq",
        true
       ],
       [
        "structure_type",
        "eq",
        "institution"
       ],
       {
        "any": [
         [
          "depth_floor_ft",
          ">=",
          "$institution_high_depth_ft"
         ],
         [
          "dv_ft2s",
          ">=",
          "$institution_high_dv"
         ]
        ]
       }
      ]
     },
     "class": 3
    },
    {
     "label": "institution Significant",
     "when": {
      "all": [
       [
        "wet",
        "eq",
        true
       ],
       [
        "structure_type",
        "eq",
        "institution"
       ],
       [
        "depth_foundation_ft",
        ">",
        0
       ]
      ]
     },
     "class": 2
    },
    {
     "label": "institution Low",
     "when": {
      "all": [
       [
        "wet",
        "eq",
        true
       ],
       [
        "structure_type",
        "eq",
        "institution"
       ]
      ]
     },
     "class": 1
    },
    {
     "label": "commercial High",
     "when": {
      "all": [
       [
        "wet",
        "eq",
        true
       ],
       [
        "structure_type",
        "eq",
        "commercial_industrial"
       ],
       {
        "any": [
         [
          "depth_foundation_ft",
          ">=",
          "$commercial_high_depth_ft"
         ],
         [
          "dv_ft2s",
          ">=",
          "$commercial_high_dv"
         ]
        ]
       }
      ]
     },
     "class": 3
    },
    {
     "label": "commercial Significant",
     "when": {
      "all": [
       [
        "wet",
        "eq",
        true
       ],
       [
        "structure_type",
        "eq",
        "commercial_industrial"
       ],
       [
        "depth_foundation_ft",
        ">=",
        "$commercial_sig_depth_ft"
       ]
      ]
     },
     "class": 2
    },
    {
     "label": "commercial Low",
     "when": {
      "all": [
       [
        "wet",
        "eq",
        true
       ],
       [
        "structure_type",
        "eq",
        "commercial_industrial"
       ]
      ]
     },
     "class": 1
    },
    {
     "label": "campground High",
     "when": {
      "all": [
       [
        "wet",
        "eq",
        true
       ],
       [
        "structure_type",
        "eq",
        "campground"
       ],
       [
        "nights_per_year",
        ">",
        "$campground_min_nights_per_year"
       ],
       {
        "any": [
         [
          "depth_ground_ft",
          ">=",
          "$campground_high_depth_ft"
         ],
         [
          "dv_ft2s",
          ">=",
          "$campground_high_dv"
         ]
        ]
       }
      ]
     },
     "class": 3
    },
    {
     "label": "campground Significant",
     "when": {
      "all": [
       [
        "wet",
        "eq",
        true
       ],
       [
        "structure_type",
        "eq",
        "campground"
       ],
       [
        "nights_per_year",
        ">",
        "$campground_min_nights_per_year"
       ],
       [
        "depth_ground_ft",
        ">=",
        "$campground_sig_depth_ft"
       ]
      ]
     },
     "class": 2
    },
    {
     "label": "campground Low",
     "when": {
      "all": [
       [
        "wet",
        "eq",
        true
       ],
       [
        "structure_type",
        "eq",
        "campground"
       ],
       [
        "nights_per_year",
        ">",
        "$campground_min_nights_per_year"
       ]
      ]
     },
     "class": 1
    },
    {
     "label": "unoccupied farm/storage Low",
     "when": {
      "all": [
       [
        "wet",
        "eq",
        true
       ],
       [
        "structure_type",
        "eq",
        "unoccupied_farm_storage"
       ],
       [
        "depth_foundation_ft",
        ">",
        0
       ]
      ]
     },
     "class": 1
    }
   ],
   "evaluation": "auto",
   "notes": "Every cell is editable. walkout_high_depth_ft defaults to 3.5; the document allows 5 ft where occupants can move upstairs (walkout_high_depth_ft_allowed). Missing floor elevation: institution rows fall back to no result and a missing-input flag is raised."
  },
  "M4a": {
   "name": "Count-by-depth: occupied structure count",
   "group": "structures_life_safety",
   "inputs": [
    "occupied structures",
    "depth_foundation_ft"
   ],
   "params": {
    "n_min": 20,
    "depth_ft": 2.0
   },
   "returns": 3,
   "strength": "advisory",
   "source": "Nebraska Classification of Dams (Dec. 2023) ('should')",
   "appendix_ref": "A.3 p.23",
   "verification": "as_documented",
   "applies_to": {
    "receptor_type": [
     "structure"
    ]
   },
   "counts": [
    {
     "select": {
      "all": [
       [
        "wet",
        "eq",
        true
       ],
       [
        "habitable",
        "eq",
        true
       ],
       [
        "depth_foundation_ft",
        ">=",
        "$depth_ft"
       ]
      ]
     },
     "measure": "count",
     "bands": [
      {
       "min": "$n_min",
       "class": 3
      }
     ]
    }
   ],
   "evaluation": "auto"
  },
  "M4b": {
   "name": "Count-by-depth: homes count x depth table",
   "group": "structures_life_safety",
   "inputs": [
    "homes",
    "depth_floor_ft",
    "m1_zone"
   ],
   "params": {
    "shallow_depth_ft": 1.0
   },
   "returns": {
    "Low": 1,
    "Significant": 2,
    "High": 3
   },
   "strength": "rule",
   "source": "New York TOGS 3.1.5 (draft)",
   "appendix_ref": "A.3 p.23",
   "verification": "as_documented",
   "applies_to": {
    "receptor_type": [
     "structure"
    ]
   },
   "counts": [
    {
     "label": "up to 1 ft at lowest occupied floor",
     "select": {
      "all": [
       [
        "wet",
        "eq",
        true
       ],
       [
        "structure_type",
        "eq",
        "home"
       ],
       [
        "depth_floor_ft",
        ">",
        0
       ],
       [
        "depth_floor_ft",
        "<=",
        "$shallow_depth_ft"
       ]
      ]
     },
     "measure": "count",
     "bands": [
      {
       "min": 1,
       "max": 10,
       "class": 1
      },
      {
       "min": 11,
       "max": 99,
       "class": 2
      },
      {
       "min": 100,
       "class": 3
      }
     ]
    },
    {
     "label": "over 1 ft at lowest occupied floor",
     "select": {
      "all": [
       [
        "wet",
        "eq",
        true
       ],
       [
        "structure_type",
        "eq",
        "home"
       ],
       [
        "depth_floor_ft",
        ">",
        "$shallow_depth_ft"
       ]
      ]
     },
     "measure": "count",
     "bands": [
      {
       "min": 1,
       "max": 10,
       "class": 2
      },
      {
       "min": 11,
       "max": 99,
       "class": 2
      },
      {
       "min": 100,
       "class": 3
      }
     ]
    },
    {
     "label": "above the Low Danger zone (M1)",
     "select": {
      "all": [
       [
        "wet",
        "eq",
        true
       ],
       [
        "structure_type",
        "eq",
        "home"
       ],
       [
        "m1_zone",
        "in",
        [
         "judgment",
         "high_danger"
        ]
       ]
      ]
     },
     "measure": "count",
     "bands": [
      {
       "min": 1,
       "class": 3
      }
     ]
    }
   ],
   "evaluation": "auto",
   "notes": "Counts are taken per depth row as tabulated; the engineer confirms how homes are grouped."
  },
  "M4c": {
   "name": "Count-by-depth: lives or habitable structures",
   "group": "structures_life_safety",
   "inputs": [
    "occupants",
    "habitable structures in the inundation area"
   ],
   "params": {},
   "returns": {
    "Significant": 2,
    "High": 3
   },
   "strength": "rule",
   "source": "Texas 30 TAC 299.14",
   "appendix_ref": "A.3 p.23",
   "verification": "as_documented",
   "applies_to": {
    "receptor_type": [
     "structure"
    ]
   },
   "counts": [
    {
     "label": "lives",
     "select": {
      "all": [
       [
        "wet",
        "eq",
        true
       ],
       [
        "habitable",
        "eq",
        true
       ]
      ]
     },
     "measure": "sum:occupants",
     "bands": [
      {
       "min": 1,
       "max": 6,
       "class": 2
      },
      {
       "min": 7,
       "class": 3
      }
     ]
    },
    {
     "label": "habitable structures",
     "select": {
      "all": [
       [
        "wet",
        "eq",
        true
       ],
       [
        "habitable",
        "eq",
        true
       ]
      ]
     },
     "measure": "count",
     "bands": [
      {
       "min": 1,
       "max": 2,
       "class": 2
      },
      {
       "min": 3,
       "class": 3
      }
     ]
    }
   ],
   "evaluation": "auto"
  },
  "M5": {
   "name": "Lives-in-jeopardy count",
   "group": "structures_life_safety",
   "inputs": [
    "lives_in_jeopardy (dam summary) or occupants of structures with m1_zone high_danger / lethal"
   ],
   "params": {
    "sig_min": null,
    "high_min": 1,
    "lowering_only": false
   },
   "returns": {
    "Significant": 2,
    "High": 3
   },
   "strength": "rule",
   "source": "FEMA 333; USBR ACER TM-11 (1-6 / over 6); BIA; Virginia TM-11 Section III variant",
   "appendix_ref": "A.3 p.23",
   "verification": "as_documented",
   "special": "lives_in_jeopardy",
   "evaluation": "auto",
   "notes": "sig_min null means no Significant band (FEMA 333: High at 1+ life). lowering_only true: the result supports lowering a proposed class only (Virginia) and is reported as advisory."
  },
  "M6": {
   "name": "Non-lethal flooding of occupied structures",
   "group": "structures_life_safety",
   "inputs": [
    "habitable structures",
    "depth_ground_ft",
    "uninhabitable flag",
    "indirect_life_loss flag"
   ],
   "params": {
    "variant": "base"
   },
   "returns": 2,
   "strength": "rule",
   "source": "FEMA 333 / ND REG_05.2026 (advisory in ND); Colorado 2 CCR 402-1; IDWR",
   "appendix_ref": "A.3 p.23-24",
   "verification": "as_documented",
   "applies_to": {
    "receptor_type": [
     "structure",
     "road",
     "feature"
    ]
   },
   "receptor_rules": [
    {
     "label": "inundated habitable structure",
     "if_param": {
      "variant": "base"
     },
     "when": {
      "all": [
       [
        "receptor_type",
        "eq",
        "structure"
       ],
       [
        "wet",
        "eq",
        true
       ],
       [
        "habitable",
        "eq",
        true
       ],
       [
        "depth_ground_ft",
        ">",
        0
       ]
      ]
     },
     "class": 2
    },
    {
     "label": "uninhabitable or inoperable",
     "if_param": {
      "variant": "uninhabitable_inoperable"
     },
     "when": {
      "all": [
       [
        "receptor_type",
        "eq",
        "structure"
       ],
       [
        "wet",
        "eq",
        true
       ],
       [
        "uninhabitable_after",
        "eq",
        true
       ]
      ]
     },
     "class": 2
    },
    {
     "label": "indirect loss of life",
     "if_param": {
      "variant": "indirect_life_loss"
     },
     "when": {
      "all": [
       [
        "indirect_life_loss",
        "eq",
        true
       ]
      ]
     },
     "class": 2
    }
   ],
   "evaluation": "auto"
  },
  "M7": {
   "name": "Population threshold for a top tier",
   "group": "structures_life_safety",
   "inputs": [
    "lives_in_jeopardy",
    "population_at_risk",
    "critical_facilities_threat"
   ],
   "params": {
    "lives_min": 1,
    "population_min": 1000
   },
   "returns": 4,
   "strength": "rule",
   "source": "California 23 CCR 335.4",
   "appendix_ref": "A.3 p.24",
   "verification": "as_documented",
   "summary_rules": [
    {
     "when": {
      "all": [
       [
        "lives_in_jeopardy",
        ">=",
        "$lives_min"
       ],
       {
        "any": [
         [
          "population_at_risk",
          ">=",
          "$population_min"
         ],
         [
          "critical_facilities_threat",
          "eq",
          true
         ]
        ]
       }
      ]
     },
     "class": 4
    }
   ],
   "evaluation": "auto"
  },
  "M8a": {
   "name": "Road traffic bands",
   "group": "infrastructure",
   "inputs": [
    "road_class",
    "aadt"
   ],
   "params": {
    "low_below_aadt": 500,
    "high_above_aadt": 2000
   },
   "returns": {
    "Low": 1,
    "Significant": 2,
    "High": 3
   },
   "strength": "rule",
   "source": "ND REG_05.2026",
   "appendix_ref": "A.4 p.24",
   "verification": "as_documented",
   "applies_to": {
    "receptor_type": [
     "road"
    ]
   },
   "receptor_rules": [
    {
     "when": {
      "all": [
       [
        "wet",
        "eq",
        true
       ],
       {
        "any": [
         [
          "road_class",
          "eq",
          "interstate"
         ],
         [
          "aadt",
          ">",
          "$high_above_aadt"
         ]
        ]
       }
      ]
     },
     "class": 3
    },
    {
     "when": {
      "all": [
       [
        "wet",
        "eq",
        true
       ],
       {
        "any": [
         [
          "road_class",
          "eq",
          "us_state_highway"
         ],
         [
          "aadt",
          ">=",
          "$low_below_aadt"
         ]
        ]
       }
      ]
     },
     "class": 2
    },
    {
     "when": {
      "all": [
       [
        "wet",
        "eq",
        true
       ],
       {
        "any": [
         [
          "road_class",
          "eq",
          "private"
         ],
         [
          "aadt",
          "<",
          "$low_below_aadt"
         ]
        ]
       }
      ]
     },
     "class": 1
    }
   ],
   "evaluation": "auto",
   "notes": "AADT of exactly 500 falls in Significant."
  },
  "M8b": {
   "name": "Sole access road",
   "group": "infrastructure",
   "inputs": [
    "sole_access"
   ],
   "params": {},
   "returns": 2,
   "strength": "rule",
   "source": "ND REG_05.2026",
   "appendix_ref": "A.4 p.24",
   "verification": "as_documented",
   "applies_to": {
    "receptor_type": [
     "road"
    ]
   },
   "receptor_rules": [
    {
     "when": {
      "all": [
       [
        "wet",
        "eq",
        true
       ],
       [
        "sole_access",
